# ComfyUI Docker Configuration
# Copy this file to .env and adjust values as needed

# Port to expose ComfyUI on (default: 8188)
COMFYUI_PORT=8188

# Note: For GPU support, ensure you have:
# 1. NVIDIA GPU with appropriate drivers
# 2. nvidia-docker2 or nvidia-container-toolkit installed
# 3. Use the comfyui-gpu service in docker-compose.yml
#
# For CPU-only mode, use the comfyui-cpu service
